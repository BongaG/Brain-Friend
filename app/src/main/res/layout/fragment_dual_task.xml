<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F8F6FF"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🧠 Dual Task Challenge"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#3B2F6E"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_instruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remember the numbers and solve math"
        android:textSize="14sp"
        android:textColor="#6B63A0"
        android:layout_marginBottom="40dp" />


    <TextView
        android:id="@+id/tv_sequence"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#5B4FCF"
        android:visibility="gone"
        android:layout_marginBottom="32dp" />


    <TextView
        android:id="@+id/tv_math_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#3B2F6E"
        android:layout_marginBottom="20dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/et_math_answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Your answer"
        android:inputType="number"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_submit_math"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Submit Math Answer"
        android:backgroundTint="#5B4FCF"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="20dp"
        android:visibility="gone" />


    <EditText
        android:id="@+id/et_sequence_recall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter the number sequence (e.g., 1 2 3)"
        android:inputType="text"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_submit_sequence"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Submit Sequence"
        android:backgroundTint="#7B68EE"
        android:textColor="#FFFFFF"
        android:visibility="gone" />


    <TextView
        android:id="@+id/tv_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#3B2F6E"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_restart"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Play Again"
        android:backgroundTint="#EDE9FF"
        android:textColor="#3B2F6E"
        android:visibility="gone" />

</LinearLayout>