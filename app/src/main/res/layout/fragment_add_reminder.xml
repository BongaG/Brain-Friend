<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2563EB"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Voice Reminder"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap the mic and say your reminder out loud"
                android:textSize="14sp"
                android:textColor="#BFDBFE"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Mic button -->
            <Button
                android:id="@+id/btn_mic"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:text="🎙"
                android:textSize="40sp"
                android:backgroundTint="#2563EB"
                android:layout_marginBottom="20dp" />

            <!-- Transcribed text -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_transcribed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textColor="#0F172A"
                    android:hint="Your reminder will appear here..."
                    android:textColorHint="#94A3B8"
                    android:visibility="visible" />
            </androidx.cardview.widget.CardView>

            <!-- Pick time button -->
            <Button
                android:id="@+id/btn_pick_time"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="⏰ Pick Reminder Time"
                android:textSize="15sp"
                android:backgroundTint="#EFF6FF"
                android:textColor="#2563EB"
                android:layout_marginBottom="12dp" />

            <!-- Scheduled time display -->
            <TextView
                android:id="@+id/tv_scheduled_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#2563EB"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="24dp" />

            <!-- Save button -->
            <Button
                android:id="@+id/btn_save_reminder"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Save Reminder ✅"
                android:textSize="17sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2563EB"
                android:layout_marginBottom="12dp" />

            <!-- View reminders button -->
            <Button
                android:id="@+id/btn_view_reminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View All Reminders"
                android:backgroundTint="#F1F5F9"
                android:textColor="#0F172A" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>