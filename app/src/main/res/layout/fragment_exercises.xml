<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F8F6FF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🧠 Brain Exercises"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2563EB"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Train your brain with fun games"
        android:textSize="14sp"
        android:textColor="#2563EB"
        android:layout_marginBottom="32dp" />

    <!-- Sequencing Game Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_sequencing_game"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        android:foreground="?android:attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📅 Step Sequencing"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2563EB" />

            <Button
                android:id="@+id/btn_start_sequencing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶️"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2563EB"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Memory Match Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_memory_match"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        android:foreground="?android:attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🃏 Memory Match"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2563EB" />

            <Button
                android:id="@+id/btn_start_memory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶️"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2563EB"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Auditory Sequence Recall Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_audio_sequence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        android:foreground="?android:attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎧 Auditory Sequence"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2563EB" />

            <Button
                android:id="@+id/btn_start_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶️"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2563EB"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- My Progress Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        android:foreground="?android:attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📊 My Progress"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2563EB" />

            <Button
                android:id="@+id/btn_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶️"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2563EB"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>