<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8F6FF">

    <TextView
        android:id="@+id/tv_scenario_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Morning Routine"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#3B2F6E"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_instruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Drag the steps into the correct order:"
        android:textSize="14sp"
        android:textColor="#6B63A0"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_steps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btn_check_order"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Check Order"
        android:backgroundTint="#5B4FCF"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btn_next_scenario"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Next Scenario ➡️"
        android:backgroundTint="#7B68EE"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Score: 0"
        android:textSize="18sp"
        android:textColor="#3B2F6E"
        android:layout_marginTop="16dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#6B63A0"
        android:layout_marginTop="8dp"
        android:visibility="gone" />
</LinearLayout>